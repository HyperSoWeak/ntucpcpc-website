---
import { SITE } from '@/lib/config';
---

<div id="terminal-overlay" hidden aria-modal="true" role="dialog" aria-label="terminal">
  <div class="terminal-box">
    <div class="term-header mono">
      <span class="term-title ps1"><span class="u">guest</span><span class="d">@</span><span class="h">ntucpcpc</span><span class="d">:</span><span class="t">~</span></span>
      <button id="terminal-close" aria-label="close terminal">×</button>
    </div>
    <div class="output mono" id="prompt-output" aria-live="polite"></div>
    <div class="input-line mono">
      <span class="ps1"><span class="u">guest</span><span class="d">@</span><span class="h">ntucpcpc</span><span class="d">:</span><span class="t">~</span><span class="dollar">$</span></span>
      <input
        id="prompt-input"
        type="text"
        autocomplete="off"
        spellcheck="false"
        aria-label="command input"
      />
    </div>
  </div>
</div>

<footer class="site-footer container">
  <div class="meta mono">
    © 2026 NTUCPC · <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
  </div>
</footer>

<style>
  /* PS1 color tokens */
  .ps1 .u      { color: var(--accent); }
  .ps1 .d      { color: var(--fg-mute); }
  .ps1 .h      { color: #60a5fa; }
  .ps1 .t      { color: var(--fg); }
  .ps1 .dollar { color: var(--fg); }

  /* overlay */
  #terminal-overlay {
    position: fixed; inset: 0; z-index: 200;
    background: rgba(11,16,24,0.75);
    backdrop-filter: blur(6px);
    display: flex; align-items: center; justify-content: center;
    padding: 24px;
  }
  #terminal-overlay[hidden] { display: none; }

  .terminal-box {
    background: #0b1018;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: var(--radius-md);
    width: 100%; max-width: 680px;
    box-shadow: 0 32px 80px rgba(0,0,0,0.8);
    overflow: hidden;
  }

  /* header */
  .term-header {
    background: #111827;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    padding: 9px 16px;
    display: flex; justify-content: space-between; align-items: center;
    font-size: 0.8rem;
    user-select: none;
  }
  #terminal-close {
    background: transparent; border: 0;
    color: var(--fg-mute); font-size: 1rem;
    cursor: pointer; line-height: 1; padding: 2px 4px;
    transition: color 150ms;
  }
  #terminal-close:hover { color: var(--fg); }

  /* output */
  .output {
    padding: 14px 18px 0;
    min-height: 40px;
    max-height: 340px;
    overflow-y: auto;
    font-size: 0.85rem;
    line-height: 1.65;
  }

  /* output line types (set by JS) */
  .output :global(.line-banner) { color: var(--fg-mute); margin-bottom: 8px; }
  .output :global(.line-banner .hi)   { color: var(--accent); }
  .output :global(.line-banner .hint) { color: var(--fg-dim); }

  .output :global(.line-cmd)           { }
  .output :global(.line-cmd .cmd-text) { color: var(--fg); }

  .output :global(.line-out)     { color: var(--fg-dim); }
  .output :global(.line-out.err) { color: #f87171; }

  /* input line */
  .input-line {
    display: flex; align-items: center; gap: 0;
    font-size: 0.85rem;
    padding: 10px 18px 14px;
    border-top: 1px solid rgba(255,255,255,0.05);
    margin-top: 10px;
  }
  .input-line .ps1 { white-space: nowrap; }
  input {
    flex: 1; background: transparent; border: 0; outline: 0;
    color: var(--fg); font: inherit; padding: 0;
    margin-left: 8px;
    caret-color: var(--fg);
  }

  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { }

  /* footer */
  .site-footer { padding-block: 40px; }
  .meta { color: var(--fg-mute); font-size: 0.8rem; text-align: center; }
  .meta a { color: var(--fg-dim); }
  .meta a:hover { color: var(--accent); text-decoration: none; }
</style>

<script>
  import { run } from '@/lib/commands';

  const overlay  = document.getElementById('terminal-overlay')!;
  const input    = document.getElementById('prompt-input') as HTMLInputElement;
  const output   = document.getElementById('prompt-output')!;
  const closeBtn = document.getElementById('terminal-close')!;
  const history: string[] = [];
  let cursor = -1;
  let welcomed = false;

  const PS1_HTML = `<span class="ps1"><span class="u">guest</span><span class="d">@</span><span class="h">ntucpcpc</span><span class="d">:</span><span class="t">~</span><span class="dollar">$</span></span>`;

  function trim() {
    while (output.childElementCount > 80) output.firstChild?.remove();
  }

  function appendCmd(cmd: string) {
    const div = document.createElement('div');
    div.className = 'line-cmd';
    div.innerHTML = PS1_HTML;
    const span = document.createElement('span');
    span.className = 'cmd-text';
    span.textContent = ' ' + cmd;
    div.appendChild(span);
    output.appendChild(div);
    trim();
    output.scrollTop = output.scrollHeight;
  }

  function appendOut(text: string) {
    const div = document.createElement('div');
    div.className = 'line-out';
    if (/not found|permission denied|no such/.test(text)) div.classList.add('err');
    div.textContent = text;
    output.appendChild(div);
    trim();
    output.scrollTop = output.scrollHeight;
  }

  function open() {
    overlay.removeAttribute('hidden');
    input.focus();
    if (!welcomed) {
      welcomed = true;
      const div = document.createElement('div');
      div.className = 'line-banner';
      div.innerHTML = `<span class="hi">NTUCPCPC 2026</span> — type <span class="hint">'help'</span> to get started.`;
      output.appendChild(div);
    }
  }

  function close() {
    overlay.setAttribute('hidden', '');
    input.blur();
  }

  window.addEventListener('ntucpcpc:launch-terminal', open);
  closeBtn.addEventListener('click', close);
  overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !overlay.hasAttribute('hidden')) close();
  });

  function execute(cmd: string) {
    if (!cmd.trim()) return;
    appendCmd(cmd);
    history.push(cmd);
    cursor = history.length;
    const r = run(cmd);
    if (r.action === 'clear') { output.innerHTML = ''; welcomed = false; return; }
    if (r.action === 'exit')  { close(); return; }
    r.lines.forEach(appendOut);
    if (r.action?.startsWith('launch:')) {
      const game = r.action.split(':')[1];
      window.dispatchEvent(new CustomEvent(`ntucpcpc:launch-${game}`));
    } else if (r.action?.startsWith('scroll:')) {
      const id = r.action.split(':')[1];
      document.getElementById(id)?.scrollIntoView({ behavior: 'smooth' });
    } else if (r.action?.startsWith('external:')) {
      window.open(r.action.slice('external:'.length), '_blank');
    }
  }

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      execute(input.value);
      input.value = '';
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (cursor > 0) cursor -= 1;
      input.value = history[cursor] ?? '';
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (cursor < history.length - 1) { cursor += 1; input.value = history[cursor]; }
      else { cursor = history.length; input.value = ''; }
    }
  });
</script>
