---
import { SITE } from '@/lib/config';
---

<!-- Terminal overlay -->
<div id="terminal-overlay" hidden aria-modal="true" role="dialog" aria-label="hidden terminal">
  <div class="terminal-box">
    <div class="term-header mono">
      <span class="ps-label">ntucpc@2026:~</span>
      <button id="terminal-close" aria-label="close terminal">×</button>
    </div>
    <div class="output mono" id="prompt-output" aria-live="polite"></div>
    <div class="input-line mono">
      <span class="ps1">$</span>
      <input
        id="prompt-input"
        type="text"
        autocomplete="off"
        spellcheck="false"
        aria-label="command input"
      />
      <span class="caret">▌</span>
    </div>
  </div>
</div>

<footer class="site-footer container">
  <div class="meta mono">
    © 2026 NTUCPC · <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
  </div>
</footer>

<style>
  /* overlay backdrop */
  #terminal-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: #0b1018b0;
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  #terminal-overlay[hidden] { display: none; }

  .terminal-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    width: 100%;
    max-width: 680px;
    box-shadow: 0 24px 64px #000000a0;
    overflow: hidden;
  }

  .term-header {
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
    padding: 10px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    color: var(--fg-dim);
  }
  #terminal-close {
    background: transparent;
    border: 0;
    color: var(--fg-mute);
    font-size: 1.2rem;
    cursor: pointer;
    line-height: 1;
    padding: 0 2px;
    transition: color 150ms;
  }
  #terminal-close:hover { color: var(--fg); }

  .output {
    min-height: 0;
    max-height: 280px;
    overflow-y: auto;
    color: var(--fg-dim);
    white-space: pre-wrap;
    font-size: 0.875rem;
    padding: 16px 18px 0;
  }
  .output:empty { padding: 0; }

  .input-line {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    padding: 12px 18px 16px;
  }
  .ps1 { color: var(--accent); }
  input {
    flex: 1; background: transparent; border: 0; outline: 0;
    color: var(--fg); font: inherit; padding: 0;
  }
  .caret { color: var(--accent); animation: blink 1.2s steps(1,end) infinite; }

  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .caret { animation: none; } }

  /* footer */
  .site-footer { padding-block: 40px; }
  .meta { color: var(--fg-mute); font-size: 0.8rem; text-align: center; }
  .meta a { color: var(--fg-dim); }
  .meta a:hover { color: var(--accent); text-decoration: none; }
</style>

<script>
  import { run } from '@/lib/commands';

  const overlay = document.getElementById('terminal-overlay')!;
  const input   = document.getElementById('prompt-input') as HTMLInputElement;
  const output  = document.getElementById('prompt-output')!;
  const closeBtn = document.getElementById('terminal-close')!;
  const history: string[] = [];
  let cursor = -1;

  function open() {
    overlay.removeAttribute('hidden');
    input.focus();
  }
  function close() {
    overlay.setAttribute('hidden', '');
    input.blur();
  }

  window.addEventListener('ntucpcpc:launch-terminal', open);
  closeBtn.addEventListener('click', close);
  overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !overlay.hasAttribute('hidden')) close();
  });

  function append(line: string) {
    const div = document.createElement('div');
    div.textContent = line;
    output.appendChild(div);
    while (output.childElementCount > 60) output.firstChild?.remove();
    output.scrollTop = output.scrollHeight;
  }

  function execute(cmd: string) {
    if (!cmd.trim()) return;
    append(`$ ${cmd}`);
    history.push(cmd);
    cursor = history.length;
    const r = run(cmd);
    if (r.action === 'clear') { output.innerHTML = ''; return; }
    if (r.action === 'exit') { close(); return; }
    r.lines.forEach(append);
    if (r.action?.startsWith('launch:')) {
      const game = r.action.split(':')[1];
      window.dispatchEvent(new CustomEvent(`ntucpcpc:launch-${game}`));
    } else if (r.action?.startsWith('scroll:')) {
      const id = r.action.split(':')[1];
      document.getElementById(id)?.scrollIntoView({ behavior: 'smooth' });
    } else if (r.action?.startsWith('external:')) {
      window.open(r.action.slice('external:'.length), '_blank');
    }
  }

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      execute(input.value);
      input.value = '';
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (cursor > 0) cursor -= 1;
      input.value = history[cursor] ?? '';
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (cursor < history.length - 1) { cursor += 1; input.value = history[cursor]; }
      else { cursor = history.length; input.value = ''; }
    }
  });
</script>
