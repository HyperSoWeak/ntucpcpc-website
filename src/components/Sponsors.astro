---
const sponsors = [
  { name: 'Jane Street', logo: '/sponsors/jane-street.png', url: 'https://www.janestreet.com/', cls: 'l-jane' },
  { name: 'Hudson River Trading', logo: '/sponsors/hrt.png', url: 'https://www.hudsonrivertrading.com/', cls: 'l-hrt' },
  { name: 'MSI', logo: '/sponsors/msi.png', url: 'https://www.msi.com/', cls: 'l-msi' },
];
const individuals = ['蘇柏瑄', '侯欣緯'];
---
<section id="sponsors" class="container">
  <div class="eyebrow path"><span class="tilde">~</span><span class="slug">/sponsors</span></div>
  <h2>贊助單位</h2>
  <div class="sponsor-grid">
    {sponsors.map((s) => (
      <a class="sponsor-card" href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.name}>
        <img class={s.cls} src={s.logo} alt={s.name} loading="lazy" />
      </a>
    ))}
  </div>

  <div class="individual-block">
    <div class="tier-head">
      <span class="tier-title">個人贊助</span>
      <span class="tier-en">individual backers</span>
    </div>
    <ul class="individual-list">
      {individuals.map((name) => (
        <li class="individual-chip"><span class="at">@</span>{name}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .sponsor-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .sponsor-card {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f4f4f5;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 28px 24px;
    min-height: 132px;
    transition: transform 150ms ease, box-shadow 150ms ease;
  }
  .sponsor-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }
  .sponsor-card img {
    max-width: 100%;
    width: auto;
    object-fit: contain;
  }
  /* per-logo optical scale */
  .l-jane { max-height: 40px; }
  .l-hrt  { max-height: 80px; }
  .l-msi  { max-height: 50px; }

  .individual-block {
    margin-top: 38px;
    padding-top: 30px;
    border-top: 1px solid var(--border-soft);
  }
  .tier-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 18px;
  }
  .tier-title { font-size: 0.95rem; font-weight: 700; color: var(--fg); }
  .tier-en {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-mute);
  }
  .individual-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .individual-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.95rem;
    color: var(--fg);
    background: var(--accent-soft);
    border: 1px solid #818cf840;
    border-radius: 999px;
    padding: 7px 16px;
  }
  .individual-chip .at { font-family: var(--font-mono); color: var(--accent); }

  @media (max-width: 640px) {
    .sponsor-grid { grid-template-columns: 1fr; }
  }
</style>
