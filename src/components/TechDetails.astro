---
import tech from '@/data/tech.md?raw';
const items = tech.trim().split('\n').filter((l) => l.startsWith('- ')).map((l) => l.slice(2));
const pairs = items.map((i) => {
  const idx = i.indexOf('：');
  return idx > -1
    ? { key: i.slice(0, idx), val: i.slice(idx + 1) }
    : { key: i, val: '' };
});
---
<section id="tech" class="container">
  <div class="eyebrow path"><span class="tilde">~</span><span class="slug">/tech</span></div>
  <h2>技術細節</h2>
  <dl class="tech-list">
    {pairs.map(({ key, val }) => (
      <div class="tech-row">
        <dt class="key">{key}</dt>
        <dd class="val">{val || '待補'}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .tech-list { margin: 0; display: grid; gap: 0; }
  .tech-row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 20px;
    padding-block: 18px;
    border-bottom: 1px solid var(--border-soft);
    align-items: baseline;
  }
  .tech-row:last-child { border-bottom: none; }
  .key {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--fg-mute);
    letter-spacing: 0.06em;
  }
  .val { font-size: 0.9375rem; color: var(--fg); margin: 0; }

  @media (max-width: 480px) {
    .tech-row { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
