---
import { SITE } from '@/lib/config';
---
<section id="register" class="container">
  <div class="eyebrow">報名資格</div>
  <h2>報名</h2>
  <div class="layout">
    <div class="items">
      <div class="item"><span class="check">✓</span><span>高中職以下（含應屆畢業生）</span></div>
      <div class="item"><span class="check">✓</span><span>一至三人一隊，同隊不必同校</span></div>
      <div class="item"><span class="check">✓</span><span>無報名費</span></div>
    </div>
    <div class="cta-block">
      <a class="btn btn-primary big" href={SITE.registerUrl} target="_blank" rel="noopener">
        立即報名 →
      </a>
      <p class="hint mono">送出後會收到 email 確認<br>未收到請聯絡 {SITE.email}</p>
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 48px;
    align-items: center;
  }
  .items { display: grid; gap: 0; }
  .item {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding-block: 20px;
    border-bottom: 1px solid var(--border-soft);
    font-size: 1rem;
  }
  .item:last-child { border-bottom: none; }
  .check { font-family: var(--font-mono); color: var(--accent); font-size: 0.875rem; flex-shrink: 0; }

  .cta-block {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 14px;
    min-width: 180px;
  }
  .btn.big { padding: 14px 28px; font-size: 1rem; font-weight: 700; letter-spacing: -0.01em; }
  .hint { color: var(--fg-mute); font-size: 0.75rem; margin: 0; text-align: right; line-height: 1.6; }

  @media (max-width: 640px) {
    .layout { grid-template-columns: 1fr; gap: 28px; }
    .cta-block { align-items: flex-start; }
    .hint { text-align: left; }
  }
</style>
