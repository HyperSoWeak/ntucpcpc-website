---
import prelim from '@/data/rules-prelim.md?raw';
import finalRules from '@/data/rules-final.md?raw';

function mdList(src: string): string[] {
  return src.trim().split('\n').filter((l) => l.startsWith('- ')).map((l) => l.slice(2));
}
const prelimItems = mdList(prelim);
const finalItems = mdList(finalRules);
const common = [
  '初賽與決賽皆採用 ICPC 制。',
  '每場比賽有 5–15 題。',
  '排名依解出題數，題數相同者比罰時。',
  '罰時 = 通過時間（分鐘）+ 錯誤數 × 20；編譯錯誤不計。',
];
---
<section id="rules" class="container">
  <div class="eyebrow">競賽規則</div>
  <h2>規則</h2>

  <div class="common-block">
    <div class="block-label">共同規則</div>
    <ul class="common-list">
      {common.map((c) => (
        <li><span class="bullet">◆</span>{c}</li>
      ))}
    </ul>
  </div>

  <div class="tab-pills">
    <button class="tab-pill active" data-tab="prelim">初賽</button>
    <button class="tab-pill" data-tab="final">決賽</button>
  </div>

  <div class="panel" id="panel-prelim">
    <ul>
      {prelimItems.map((it) => (
        <li set:html={it.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')} />
      ))}
    </ul>
  </div>
  <div class="panel" id="panel-final" hidden>
    <ul>
      {finalItems.map((it) => (
        <li set:html={it.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')} />
      ))}
    </ul>
  </div>
</section>

<style>
  .common-block {
    margin-bottom: 36px;
  }
  .block-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--fg-mute);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .common-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .common-list li {
    display: flex;
    gap: 10px;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--fg);
  }
  .bullet { color: var(--accent); font-size: 0.5rem; flex-shrink: 0; margin-top: 7px; }

  .tab-pills { display: flex; gap: 6px; margin-bottom: 20px; }
  .tab-pill {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 7px 20px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--fg-dim);
    cursor: pointer;
    transition: all 150ms ease;
  }
  .tab-pill:hover { border-color: var(--accent); color: var(--accent); }
  .tab-pill.active {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent);
  }

  .panel ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0; }
  .panel li {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--fg);
    padding-block: 12px;
    border-bottom: 1px solid var(--border-soft);
    padding-left: 16px;
    position: relative;
  }
  .panel li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 20px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--fg-mute);
  }
  .panel li:last-child { border-bottom: none; }
  .panel strong { color: var(--accent); font-weight: 600; }
</style>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('#rules .tab-pill');
  const panels: Record<string, HTMLElement> = {
    prelim: document.getElementById('panel-prelim')!,
    final:  document.getElementById('panel-final')!,
  };
  pills.forEach((pill) => pill.addEventListener('click', () => {
    pills.forEach((p) => p.classList.remove('active'));
    pill.classList.add('active');
    Object.entries(panels).forEach(([k, el]) => {
      if (k === pill.dataset.tab) el.removeAttribute('hidden');
      else el.setAttribute('hidden', '');
    });
  }));
</script>
