---
import purpose from '@/data/purpose.md?raw';
const paragraphs = purpose.trim().split(/\n\n+/);
---
<section id="purpose" class="container">
  <div class="eyebrow path"><span class="tilde">~</span><span class="slug">/purpose</span></div>
  <h2>宗旨</h2>
  <div class="prose">
    {paragraphs.map((p) => <p>{p}</p>)}
  </div>
</section>

<style>
  .prose {
    border-left: 2px solid var(--accent);
    padding-left: 24px;
  }
  .prose p {
    color: var(--fg);
    font-size: 1.025rem;
    line-height: 1.85;
    margin-bottom: 1.2em;
  }
  .prose p:last-child { margin-bottom: 0; }
</style>
