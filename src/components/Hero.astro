---
import { SITE } from '@/lib/config';
import Countdown from './Countdown.astro';
---
<section id="hero" class="hero container">
  <button class="prompt mono" id="hero-prompt" aria-label="open terminal">
    <span class="ps1">$</span>
    <span class="cmd">./ntucpcpc --year 2026</span>
  </button>

  <h1 class="title">NTUCPCPC</h1>
  <div class="rule" aria-hidden="true">━━━━━━━━━━━━━━━━━━━━━━━━━━</div>
  <p class="subtitle mono"># 程式解題社程式解題競賽 · 2026</p>

  <div class="cta">
    <a class="btn btn-primary cta-register" href={SITE.registerUrl} target="_blank" rel="noopener">
      <span class="label">[ register ]</span>
    </a>
    <a class="btn" href="#rules"><span>$ man rules</span></a>
  </div>

  <Countdown />
</section>

<style>
  .hero { padding-block: 96px 64px; }

  .prompt {
    color: var(--fg-dim);
    font-size: 0.9rem;
    margin-bottom: 28px;
    display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap;
    background: transparent; border: 0; padding: 0;
    cursor: pointer; text-align: left;
    transition: opacity 150ms ease;
  }
  .prompt:hover { opacity: 0.75; }
  .prompt .ps1 { color: var(--accent); }
  .prompt .cmd { color: var(--fg); }

  .title {
    font-size: clamp(3rem, 9vw, 5.5rem);
    letter-spacing: -0.035em;
    line-height: 1;
    margin: 0 0 12px;
    font-weight: 700;
    color: var(--fg);
  }

  .rule {
    font-family: var(--font-mono);
    color: var(--accent);
    letter-spacing: -0.1em;
    line-height: 1;
    margin-bottom: 16px;
    overflow: hidden;
    max-width: 26ch;
  }

  .subtitle {
    color: var(--fg-dim);
    margin-bottom: 32px;
    font-size: 0.95rem;
  }

  .cta { display: flex; gap: 12px; flex-wrap: nowrap; margin-bottom: 8px; max-width: 100%; }
  .cta .btn { font-family: var(--font-mono); white-space: nowrap; }
  /* keep button width stable so the hover boundary never shifts past the cursor */
  .cta-register {
    min-width: 12ch;
    justify-content: flex-start;
    overflow: hidden;
  }
  .cta-register .label {
    display: inline-block;
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .cta { flex-wrap: wrap; }
  }
</style>

<script>
  import { SITE } from '@/lib/config';

  document.getElementById('hero-prompt')!.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('ntucpcpc:launch-terminal'));
  });

  const btn = document.querySelector('.cta-register .label') as HTMLElement;
  if (btn) {
    const original = btn.textContent ?? '[ register ]';
    let hoverHost = SITE.registerUrl;
    try { hoverHost = new URL(SITE.registerUrl).hostname; } catch {}
    const hover = `$ xdg-open ${hoverHost}`;
    let typing: number | null = null;
    let state: 'idle' | 'hover' = 'idle';
    function type(target: string) {
      if (typing !== null) { clearInterval(typing); typing = null; }
      let i = 0;
      btn.textContent = '';
      typing = window.setInterval(() => {
        i += 1;
        btn.textContent = target.slice(0, i);
        if (i >= target.length) { clearInterval(typing!); typing = null; }
      }, 12);
    }
    const a = btn.closest('a')!;
    function enter() {
      if (state === 'hover') return;
      state = 'hover';
      type(hover);
    }
    function leave() {
      if (state === 'idle') return;
      state = 'idle';
      type(original);
    }
    a.addEventListener('mouseenter', enter);
    a.addEventListener('mouseleave', leave);
    a.addEventListener('focus', enter);
    a.addEventListener('blur', leave);
  }
</script>
