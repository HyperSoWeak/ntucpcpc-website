---
import { SITE } from '@/lib/config';
import Countdown from './Countdown.astro';
---
<section id="hero" class="hero container">
  <img src="/logo.png" alt="NTUCPC" class="hero-logo" />

  <button class="prompt mono" id="hero-prompt" aria-label="open terminal">
    <span class="ps1">$</span>
    <span class="cmd">./ntucpcpc --year 2026</span>
  </button>

  <h1 class="title"><span class="t-ntu">NTU</span><span class="t-cpc">CPCPC</span></h1>
  <div class="rule" aria-hidden="true">━━━━━━━━━━━━━━━━━━━━━━━━━━</div>
  <p class="subtitle mono"># 程式解題社程式解題競賽 · 2026</p>

  <div class="cta">
    <a class="btn btn-primary big" href={SITE.registerUrl} target="_blank" rel="noopener">
      立即報名 →
    </a>
    <a class="btn big" href="#rules">查看規則</a>
  </div>

  <Countdown />
</section>

<style>
  .hero { padding-block: 72px 64px; }

  .hero-logo {
    width: 80px; height: 80px;
    object-fit: contain;
    margin-bottom: 24px;
    display: block;
  }

  .prompt {
    color: var(--fg-dim);
    font-size: 0.9rem;
    margin-bottom: 28px;
    display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap;
    background: transparent; border: 0; padding: 0;
    cursor: pointer; text-align: left;
    transition: opacity 150ms ease;
  }
  .prompt:hover { opacity: 0.75; }
  .prompt .ps1 { color: var(--accent); }
  .prompt .cmd { color: var(--fg); }

  .title {
    font-size: clamp(3rem, 9vw, 5.5rem);
    letter-spacing: -0.035em;
    line-height: 1;
    margin: 0 0 12px;
    font-weight: 700;
  }
  .t-ntu { color: var(--accent); }
  .t-cpc { color: var(--fg); }

  .rule {
    font-family: var(--font-mono);
    color: var(--accent);
    letter-spacing: -0.1em;
    line-height: 1;
    margin-bottom: 16px;
    overflow: hidden;
    max-width: 26ch;
  }

  .subtitle {
    color: var(--fg-dim);
    margin-bottom: 32px;
    font-size: 0.95rem;
  }

  .cta { display: flex; gap: 12px; flex-wrap: nowrap; margin-bottom: 8px; }
  .cta .btn { white-space: nowrap; }
  @media (max-width: 480px) {
    .cta { flex-wrap: wrap; }
  }
</style>

<script>
  document.getElementById('hero-prompt')!.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('ntucpcpc:launch-terminal'));
  });
</script>
